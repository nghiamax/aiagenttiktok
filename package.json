{
  "name": "tiktok-shop-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:all": "concurrently -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "login": "tsx server/login.ts",
    "user": "tsx server/userCli.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p tests && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fees:update": "tsx scripts/update-category-fees.ts"
  },
  "dependencies": {
    "express": "4.22.3",
    "lucide-react": "0.460.0",
    "pdfjs-dist": "4.10.38",
    "playwright-core": "1.49.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
