# Biến môi trường trên VPS (setup.sh tạo .env từ file này, thay <TEN_MIEN>)
# Server chỉ nghe trong máy, Caddy (HTTPS) đứng trước chuyển vào
HOST=127.0.0.1
PORT=8787
# Địa chỉ web công khai — TikTok trả về đây khi bấm Kết nối TikTok
PUBLIC_URL=https://<TEN_MIEN>
# Cookie đăng nhập chỉ gửi qua HTTPS
COOKIE_SECURE=1
# Đứng sau Caddy → lấy IP thật để chống dò mật khẩu
TRUST_PROXY=1
